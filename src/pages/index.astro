---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import BreedCard from '@components/breed/BreedCard.astro';
import AlphabetNav from '@components/ui/AlphabetNav.astro';
import { canonicalURL } from '@utils/urls';
import { organizationSchema, websiteSchema } from '@utils/schema';

const breeds = await getCollection('breeds');
const allBreeds = breeds.map(b => ({ ...b.data, slug: b.slug })).sort((a, b) => a.name.localeCompare(b.name));
const featuredBreeds = allBreeds.filter(b => b.featured).sort((a, b) => a.order - b.order);
const categories = await getCollection('categories');

const sd = {
  ...organizationSchema(),
  ...websiteSchema(),
};
---

<BaseLayout
  title="Cat Breed Encyclopedia - Discover 150+ Cat Breeds"
  description="Explore our comprehensive guide to 150+ cat breeds. Find the perfect feline companion with detailed breed profiles, care guides, photos, and temperament information."
  canonicalURL={canonicalURL('')}
  ogType="website"
  structuredData={sd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-content">
      <h1>Discover Your<br/>Perfect Cat Breed</h1>
      <p>Explore 150+ cat breeds with detailed profiles, temperament guides, care tips, and stunning photos. Whether you're looking for a playful kitten or a calm companion, we'll help you find your match.</p>
      <div class="hero-actions">
        <a href="/breeds/" class="btn-primary">Browse All Breeds A-Z</a>
        <a href="/categories/popular/" class="btn-secondary">Popular Breeds</a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="categories-section">
    <div class="container">
      <h2>Browse by Category</h2>
      <div class="categories-grid">
        {categories.map(cat => (
          <a href={`/categories/${cat.slug}/`} class="category-card">
            {cat.data.icon && <span class="cat-icon">{cat.data.icon}</span>}
            <h3>{cat.data.name}</h3>
            <p>{cat.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Breeds -->
  {featuredBreeds.length > 0 && (
    <section class="featured-section">
      <div class="container">
        <h2>Featured Breeds</h2>
        <div class="featured-grid">
          {featuredBreeds.slice(0, 6).map(breed => (
            <BreedCard breed={breed} showCategory={true} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- A-Z Quick -->
  <section class="az-section">
    <div class="container">
      <h2>All Breeds A-Z</h2>
      <AlphabetNav
        availableLetters={[...new Set(allBreeds.map(b => b.name[0].toUpperCase()))].sort()}
        baseUrl="/breeds/"
      />
      <div class="az-link">
        <a href="/breeds/">View Complete A-Z Index ({allBreeds.length} breeds)</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Not Sure Which Breed Is Right For You?</h2>
      <p>Browse our categories by coat type, temperament, and lifestyle needs to find your ideal feline friend.</p>
      <a href="/breeds/" class="btn-primary">Start Exploring</a>
    </div>
  </section>
</BaseLayout>

<style>
.hero {
  background: linear-gradient(135deg, var(--color-bg-alt), var(--color-bg));
  padding: var(--space-3xl) 0;
  text-align: center;
}
.hero-content {
  max-width: 800px;
  margin: 0 auto;
}
.hero h1 {
  font-size: var(--font-size-4xl);
  margin-bottom: var(--space-lg);
  line-height: 1.2;
}
@media (min-width: 768px) {
  .hero h1 { font-size: 3.5rem; }
}
.hero p {
  font-size: var(--font-size-lg);
  color: var(--color-muted);
  margin-bottom: var(--space-xl);
  line-height: 1.7;
}
.hero-actions {
  display: flex;
  gap: var(--space-md);
  justify-content: center;
  flex-wrap: wrap;
}
.btn-primary, .btn-secondary {
  display: inline-block;
  padding: 12px 24px;
  border-radius: var(--border-radius);
  font-weight: 600;
  font-size: var(--font-size-lg);
  transition: all 0.2s;
}
.btn-primary {
  background: var(--color-accent);
  color: #fff;
}
.btn-primary:hover {
  background: var(--color-accent-hover);
  color: #fff;
}
.btn-secondary {
  background: transparent;
  color: var(--color-accent);
  border: 2px solid var(--color-accent);
}
.btn-secondary:hover {
  background: var(--color-accent);
  color: #fff;
}

.categories-section {
  padding: var(--space-3xl) 0;
}
.categories-section h2,
.featured-section h2,
.az-section h2 {
  text-align: center;
  margin-bottom: var(--space-xl);
}
.categories-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-md);
}
@media (min-width: 480px) { .categories-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 768px) { .categories-grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1100px) { .categories-grid { grid-template-columns: repeat(4, 1fr); } }
.category-card {
  display: block;
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--space-lg);
  text-decoration: none;
  color: var(--color-primary);
  transition: all 0.2s;
}
.category-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  color: var(--color-primary);
  border-color: var(--color-accent);
}
.cat-icon { font-size: 2rem; display: block; margin-bottom: var(--space-sm); }
.category-card h3 { font-size: var(--font-size-lg); margin-bottom: var(--space-xs); }
.category-card p {
  font-size: var(--font-size-sm);
  color: var(--color-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.featured-section {
  padding: var(--space-3xl) 0;
  background: var(--color-bg-alt);
}
.featured-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-lg);
}
@media (min-width: 480px) { .featured-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 900px) { .featured-grid { grid-template-columns: repeat(3, 1fr); } }

.az-section {
  padding: var(--space-3xl) 0;
  text-align: center;
}
.az-link {
  margin-top: var(--space-lg);
}
.az-link a {
  font-weight: 600;
}

.cta-section {
  padding: var(--space-3xl) 0;
  background: var(--color-primary);
  color: #fff;
}
.cta-inner {
  text-align: center;
}
.cta-inner h2 { color: #fff; margin-bottom: var(--space-sm); }
.cta-inner p { color: #ccc; margin-bottom: var(--space-xl); font-size: var(--font-size-lg); }
</style>
