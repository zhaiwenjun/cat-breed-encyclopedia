---
import { siteConfig } from '@data/siteConfig';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${siteConfig.name} - Home`}>
      <span class="logo-icon">🐱</span>
      <span class="logo-text">{siteConfig.name}</span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle menu">
        <span class="hamburger"></span>
      </label>
      <ul class="nav-list">
        <li><a href="/">Home</a></li>
        <li><a href="/breeds/">All Breeds</a></li>
        <li class="nav-dropdown">
          <span class="nav-dropdown-label">Categories</span>
          <ul class="nav-dropdown-menu">
            <li><a href="/categories/longhair/">Longhair</a></li>
            <li><a href="/categories/shorthair/">Shorthair</a></li>
            <li><a href="/categories/hairless/">Hairless</a></li>
            <li><a href="/categories/large/">Large</a></li>
            <li><a href="/categories/hypoallergenic/">Hypoallergenic</a></li>
            <li><a href="/categories/rare/">Rare</a></li>
            <li><a href="/categories/popular/">Popular</a></li>
          </ul>
        </li>
        <li><a href="/about/">About</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
.site-header {
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 100;
  padding: var(--space-sm) 0;
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-lg);
}
.logo {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  color: var(--color-primary);
  font-size: var(--font-size-xl);
  font-weight: 700;
  text-decoration: none;
}
.logo:hover { color: var(--color-accent); }
.logo-icon { font-size: var(--font-size-2xl); }
.logo-text { display: none; }
@media (min-width: 480px) { .logo-text { display: inline; } }

.nav-toggle-input { display: none; }
.nav-toggle-label { display: block; cursor: pointer; padding: var(--space-sm); }
.hamburger, .hamburger::before, .hamburger::after {
  display: block; width: 24px; height: 2px;
  background: var(--color-primary); transition: 0.3s;
}
.hamburger { position: relative; }
.hamburger::before { content: ''; position: absolute; top: -6px; }
.hamburger::after { content: ''; position: absolute; top: 6px; }

.nav-toggle-input:checked ~ .nav-toggle-label .hamburger { background: transparent; }
.nav-toggle-input:checked ~ .nav-toggle-label .hamburger::before { top: 0; transform: rotate(45deg); }
.nav-toggle-input:checked ~ .nav-toggle-label .hamburger::after { top: 0; transform: rotate(-45deg); }

.nav-list {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  list-style: none;
  padding: var(--space-md);
  margin: 0;
  flex-direction: column;
  gap: var(--space-sm);
  box-shadow: var(--shadow-md);
}
.nav-toggle-input:checked ~ .nav-list { display: flex; }

.nav-list a, .nav-dropdown-label {
  color: var(--color-primary);
  padding: var(--space-sm) var(--space-md);
  display: block;
  border-radius: var(--border-radius);
  font-weight: 500;
}
.nav-list a:hover { background: var(--color-bg-alt); color: var(--color-accent); }
.nav-dropdown-label { cursor: default; font-weight: 600; }

.nav-dropdown-menu {
  list-style: none;
  padding-left: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.nav-dropdown-menu a { font-size: var(--font-size-sm); font-weight: 400; }

@media (min-width: 768px) {
  .nav-toggle-label { display: none; }
  .nav-list {
    display: flex;
    position: static;
    flex-direction: row;
    gap: var(--space-xs);
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
  }
  .nav-dropdown { position: relative; }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-sm);
    min-width: 200px;
    box-shadow: var(--shadow-md);
  }
  .nav-dropdown:hover .nav-dropdown-menu { display: flex; }
}
</style>