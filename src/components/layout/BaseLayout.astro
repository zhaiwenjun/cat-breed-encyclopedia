---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL: string;
  noindex?: boolean;
  ogType?: string;
  structuredData?: Record<string, unknown>;
}
const { title, description, image, canonicalURL, noindex, ogType, structuredData } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead
    title={title}
    description={description}
    image={image}
    canonicalURL={canonicalURL}
    noindex={noindex}
    ogType={ogType}
    structuredData={structuredData}
  />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>